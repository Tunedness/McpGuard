{
  "name": "@tunedness/mcpguard",
  "version": "0.1.1",
  "description": "Put a guard in front of your MCP servers. The McpGuard command line entry point.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tunedness/McpGuard.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Tunedness/McpGuard#readme",
  "bugs": {
    "url": "https://github.com/Tunedness/McpGuard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "mcpguard": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "proxy",
    "prompt-injection",
    "pii",
    "audit"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@tunedness/mcpguard-core": "0.1.1",
    "@tunedness/mcpguard-detect": "0.1.1",
    "@tunedness/mcpguard-proxy": "0.1.1",
    "@tunedness/mcpguard-ruleset": "^0.1.1",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
