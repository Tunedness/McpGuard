{
  "name": "@mcpguard/core",
  "version": "0.0.0",
  "description": "Pure decision engine for McpGuard: policy, access control, manifest pinning and the hash-chained audit record. No I/O, no protocol.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "default": "./dist/policy/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./schemas/guardpolicy.v1.schema.json": "./schemas/guardpolicy.v1.schema.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "schemas",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "schema:generate": "node scripts/generate-schema.mts",
    "schema:check": "node scripts/generate-schema.mts --check"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
