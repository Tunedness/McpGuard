{
  "name": "@tunedness/mcpguard-ruleset",
  "version": "0.1.1",
  "description": "The McpGuard detection ruleset: injection signatures, lexicons and PII recognisers, versioned independently of the engine that runs them.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tunedness/McpGuard.git",
    "directory": "packages/ruleset"
  },
  "homepage": "https://github.com/Tunedness/McpGuard#readme",
  "bugs": {
    "url": "https://github.com/Tunedness/McpGuard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rulesets/*": "./rulesets/*",
    "./lexicon/*": "./lexicon/*"
  },
  "files": [
    "README.md",
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "rulesets",
    "lexicon",
    "index.json",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "publishConfig": {
    "access": "public"
  }
}
