{
  "name": "@tunedness/mcpguard-proxy",
  "version": "0.1.1",
  "description": "The McpGuard MCP adapter: a server/client pair that guards tools/call, tools/list and resources/read, and forwards everything else untouched.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tunedness/McpGuard.git",
    "directory": "packages/proxy"
  },
  "homepage": "https://github.com/Tunedness/McpGuard#readme",
  "bugs": {
    "url": "https://github.com/Tunedness/McpGuard/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "NOTICE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@tunedness/mcpguard-core": "^0.1.1",
    "@tunedness/mcpguard-detect": "^0.1.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
