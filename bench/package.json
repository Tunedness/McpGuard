{
  "name": "@tunedness/mcpguard-bench",
  "version": "0.0.0",
  "private": true,
  "description": "The McpGuard detection corpus, the replay and sweep harness, and the latency harness. Never published.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "corpus:injection": "node dist/injection/generate.js",
    "bench:injection": "node dist/injection/run.js",
    "bench:latency": "node dist/latency/run.js",
    "bench:latency:http": "node dist/latency/http.js",
    "corpus:phi": "node dist/phi/generate.js",
    "bench:phi": "node dist/phi/run.js",
    "bench:judge": "node dist/judge/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@tunedness/mcpguard": "*",
    "@tunedness/mcpguard-core": "*",
    "@tunedness/mcpguard-detect": "*",
    "@tunedness/mcpguard-proxy": "*",
    "@tunedness/mcpguard-ruleset": "*",
    "zod": "^4.6.5"
  }
}
