{
  "name": "mcpguard-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "McpGuard monorepo root \u2014 a transparent MCP security proxy: injection scanning, PII masking, access control, manifest pinning and a tamper-evident audit log.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*",
    "bench"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && node -e \"require('node:fs').rmSync('coverage',{recursive:true,force:true})\"",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "npm run build && npm run schema:generate --workspace @mcpguard/core",
    "schema:check": "npm run build && npm run schema:check --workspace @mcpguard/core",
    "bench:corpus": "npm run build && node bench/dist/injection/generate.js",
    "bench:injection": "npm run build && node bench/dist/injection/run.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "fast-check": "^4.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
